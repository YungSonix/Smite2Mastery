# Copy to `.env` for local dev — never commit `.env` (gitignored).
# Set the same keys in Vercel / Expo dashboard for production builds.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your_supabase_anon_key_here

# Optional
EXPO_PUBLIC_WEB_INSPECT_LOCK=true
EXPO_PUBLIC_TWITCH_CLIENT_ID=your_twitch_client_id_if_used
