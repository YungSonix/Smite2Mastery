    {
      "title": "Bug Fixes",
      "anchor": "Bug_Fixes",
      "level": 2,
      "content": [
        {
          "type": "list",
          "items": [
            {
              "text": "General",
              "bold": true,
              "items": [
                {
                  "text": "Conquest",
                  "items": [
                    {
                      "text": "Fixed an issue where the Towers near the Teleporters could be hit from outside their range with longer penetrating basic attacks (Ra’s Divine Light). Now if you hit the Tower from over the wall, you’ll be considered as a valid target for 1 second and get hit unless you leave the radius, so free Tower damage can no longer happen"
                    },
                    {
                      "text": "Fixed an issue with the Fire Giant projectile meteor attacks not dealing any damage when they landed"
                    },
                    {
                      "text": "Fixed visual issues with the buff belts playing FX outside the belt radius"
                    },
                    {
                      "text": "Fixed an issue where minions coming out of relevancy vision range would always play their spawn in VFX"
                    }
                  ]
                },
                {
                  "text": "God Bots",
                  "items": [
                    {
                      "text": "Fixed instances where God Bots could get stuck trying to path around enemy minions"
                    }
                  ]
                }
              ]
            },
            {
              "text": "Gods",
              "bold": true,
              "items": [
                {
                  "text": "The Morrigan",
                  "items": [
                    {
                      "text": "Fixed an issue where she’d turn into Ares and chains would sometimes persist visually for the rest of the match"
                    }
                  ]
                },
                {
                  "text": "Athena",
                  "items": [
                    {
                      "text": "Fixed an issue where her Reach passive was not going through walls"
                    }
                  ]
                },
                {
                  "text": "Nu Wa",
                  "items": [
                    {
                      "text": "Fixed an issue where her Minion basic attack damage wasn’t scaling with each rank and staying at their rank 1 damage"
                    }
                  ]
                },
                {
                  "text": "Danzaburou",
                  "items": [
                    {
                      "text": "Fixed an issue where he couldn’t fire his Ultimate while crippled"
                    }
                  ]
                },
                {
                  "text": "Fenrir",
                  "items": [
                    {
                      "text": "Fixed issues where the initial bite from his Ultimate would often dry fire if used quickly"
                    }
                  ]
                },
                {
                  "text": "Sol",
                  "items": [
                    {
                      "text": "Fixed an issue where she couldn’t jump while Disapparate was active, or in her immune state"
                    }
                  ]
                },
                {
                  "text": "Yemoja",
                  "items": [
                    {
                      "text": "Fixed an issue where her Moonstrike VFX were hard to see for enemies"
                    }
                  ]
                },
                {
                  "text": "Zeus",
                  "items": [
                    {
                      "text": "Fixed an issue with his Chain Lightning tooltip on the God Page showing the wrong bounce numbers"
                    }
                  ]
                }
              ]
            },
            {
              "text": "UI",
              "bold": true,
              "items": [
                {
                  "text": "Fixed an issue where navigation highlighting wasn’t working past the top two rows of the Enemy team on the Console Scoreboard"
                },
                {
                  "text": "Fixed an issue when selecting a God in God Select and backing out to the expanded list the Lock In button would become overlapped"
                },
                {
                  "text": "Fixed issues with the Nameplate Display of Player Name and Title not showing other player’s equipped Titles properly"
                },
                {
                  "text": "Fixed alignment issues on the God Page on Gods that had longer subtitle descriptions"
                },
                {
                  "text": "Fixed an issue in the Item Store where the Active Item limit count wasn’t dynamically updating properly if Active Items were sold"
                },
                {
                  "text": "Fixed an issue with the Split Item Store where owned green indicators disappeared when swapping to a different tab"
                }
              ]
            },
            {
              "text": "Items",
              "bold": true,
              "items": [
                {
                  "text": "Sun Beam Bow",
                  "items": [
                    {
                      "text": "Fixed an issue where this item could get into a state causing infinite procs with no mana being spent, or double procs when activated again after breaking"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "subsections": []
    },
