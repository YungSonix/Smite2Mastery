  "sections": [
    {
      "title": "General Changes",
      "anchor": "General_Changes",
      "level": 2,
      "content": [
        {
          "type": "list",
          "items": [
            {
              "text": "Added support for DLSS, FSR, and XeSS upscaling (requires Anti-Aliasing Method set to TAA)."
            },
            {
              "text": "Added the Berserker controller layout in Control Settings."
            },
            {
              "text": "Improvements to the in game Combat Log to display the information more clearly."
            },
            {
              "text": "Improved the off screen damage numbers in-game to function similarly to SMITE 1."
            },
            {
              "text": "Added God names to the exclusive cosmetic item descriptions for their Titles, Card Effects, and Global Emotes to differentiate them better in the Player Loadout."
            },
            {
              "text": "God's screen environment upgrade."
            }
          ]
        },
        {
          "type": "list",
          "items": [
            {
              "text": "New match settings popup to choose manual vs auto build or auto skill while in the draft lobby."
            }
          ]
        }
      ],
      "subsections": []
    },
    {
      "title": "Conquest",
      "anchor": "Conquest",
      "level": 2,
      "content": [
        {
          "type": "list",
          "items": [
            {
              "text": "Updated the Fire Giant buff material that applies to Gods to be brighter and more intense"
            },
            {
              "text": "Conquest Vs AI",
              "items": [
                {
                  "text": "Adjusted Bot behavior and gamemode balance to help facilitate faster co-op matches",
                  "items": [
                    {
                      "text": "Adjusted balance specifically for Conquest Vs AI:",
                      "items": [
                        {
                          "text": "Increased Gold spooling rate"
                        },
                        {
                          "text": "Increased Gold/XP gain"
                        },
                        {
                          "text": "Decreased Tower/Phoenix Protections"
                        }
                      ]
                    },
                    {
                      "text": "God Bots on the human team (Order) will now try to do plays around Gold Fury, Fire Giant, and Tower/Phoenix"
                    },
                    {
                      "text": "Reduced the likelihood for God Bots on the enemy team (Chaos) to defend their late game structures"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "subsections": []
    },
    {
      "title": "New Gods",
      "anchor": "New_Gods",
      "level": 2,
      "subsections": [
        {
          "title": "Thor",
          "anchor": "Thor",
          "level": 3,
          "content": [
            {
              "type": "list",
              "items": [
                {
                  "text": "General",
                  "items": [
                    {
                      "text": "Deals Physical Damage"
                    },
                    {
                      "text": "Strength Scaling"
                    },
                    {
                      "text": "Melee Basic Attacks"
                    }
                  ]
                },
                {
                  "text": "Warrior’s Madness",
                  "items": [
                    {
                      "text": "Thor gains 7 Strength for each enemy near him."
                    },
                    {
                      "text": "New Feature:",
                      "bold": true,
                      "detail": "After using Berserker’s Barrage or Anvil of Dawn, Thor is Thunderstruck. While Thunderstruck, Mjolnir deals bonus Physical Damage that can arc to up to 2 nearby enemies."
                    }
                  ]
                },
                {
                  "text": "Mjolnir’s Attunement",
                  "items": [
                    {
                      "text": "Thor throws Mjolnir forward, dealing Physical Damage to enemies as it travels. When it reaches max range it flies back towards him. Thor may reactivate this ability while Mjolnir is traveling to teleport to and catch Mjolnir."
                    }
                  ]
                },
                {
                  "text": "Tectonic Rift",
                  "items": [
                    {
                      "text": "Thor slams Mjolnir down, creating a fissure, dealing Physical Damage as it erupts. Enemies hit are also Stunned. The fissure blocks movement, but allows projectiles to pass through."
                    },
                    {
                      "text": "New Feature: Thor can reactivate this ability to bring the fissure down early.",
                      "bold": true
                    }
                  ]
                },
                {
                  "text": "Berserker Barrage",
                  "items": [
                    {
                      "text": "Thor spins twice, dealing Physical Damage around him, and unleashes a final cone attack in front of him that deals Physical Damage."
                    },
                    {
                      "text": "New Feature: Thor is Thunderstruck for 3 seconds after casting Berserker Barrage.",
                      "bold": true
                    }
                  ]
                },
                {
                  "text": "Anvil of Dawn",
                  "items": [
                    {
                      "text": "Thor flies into the sky, and is able to choose a location to land, dealing Physical Damage in the area."
                    },
                    {
                      "text": "New Feature: Thor is Thunderstruck for 6 seconds after landing.",
                      "bold": true
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Poseidon",
          "anchor": "Poseidon",
          "level": 3,
          "content": [
            {
              "type": "list",
              "items": [
                {
                  "text": "General",
                  "items": [
                    {
                      "text": "Deals Magical Damage"
                    },
                    {
                      "text": "Intelligence Scaling"
                    },
                    {
                      "text": "Ranged Basic Attacks"
                    }
                  ]
                },
                {
                  "text": "Changing Tides",
                  "items": [
                    {
                      "text": "Hitting Basic Attacks increases Poseidon’s Tide, granting him Movement Speed and additional damage to his abilities. Using abilities decreases Tide."
                    }
                  ]
                },
                {
                  "text": "Tidal Surge",
                  "items": [
                    {
                      "text": "Summon a wave, dealing damage and Knocking Back enemies."
                    }
                  ]
                },
                {
                  "text": "Trident",
                  "items": [
                    {
                      "text": "Gain increased Attack Speed, Movement Speed, and Basic Attack damage."
                    },
                    {
                      "text": "New Feature",
                      "bold": true,
                      "detail": ": While activated, Tidal Surge and Basic Attacks fire two additional shots."
                    }
                  ]
                },
                {
                  "text": "Whirlpool",
                  "items": [
                    {
                      "text": "Summon a whirlpool, Crippling, Vortexing, and dealing damage repeatedly to enemies in the area."
                    }
                  ]
                },
                {
                  "text": "Release the Kraken!",
                  "items": [
                    {
                      "text": "Summon the Kraken, dealing damage and Slowing enemies in the area. Enemies in the center area when it spawns take increased damage, are Stunned, and Knocked Up."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Cupid",
          "anchor": "Cupid",
          "level": 3,
          "content": [
            {
              "type": "list",
              "items": [
                {
                  "text": "General",
                  "items": [
                    {
                      "text": "Deals Physical Damage"
                    },
                    {
                      "text": "Hybrid Scaling"
                    },
                    {
                      "text": "Ranged Basic Attacks"
                    }
                  ]
                },
                {
                  "text": "Lovestruck",
                  "items": [
                    {
                      "text": "Hitting a Basic Attack grants a stack, or 2 stacks if the target is an enemy god. These stacks are consumed to provide Cupid’s abilities with additional damage, healing or other unique effects."
                    },
                    {
                      "text": "New Feature",
                      "bold": true,
                      "detail": ": Cupid now gains up to a max of 16 stacks."
                    }
                  ]
                },
                {
                  "text": "Heart Bomb",
                  "items": [
                    {
                      "text": "Fire an arrow of love, dealing damage and Slowing the first target hit. After 3s, the heart explodes, dealing damage in an area around the target. If Cupid has 8 stacks of Lovestruck, all enemies in the area are also Stunned."
                    }
                  ]
                },
                {
                  "text": "Share the Love",
                  "items": [
                    {
                      "text": "New Feature",
                      "bold": true,
                      "detail": ": Cupid lobs an explosive bomb at a location that detonates after 0.75s, dealing damage to all targets in an area."
                    },
                    {
                      "text": "When the bomb explodes, 3 hearts spawn around the detonation location, healing and restoring mana to any ally that picks them up."
                    },
                    {
                      "text": "New Feature",
                      "bold": true,
                      "detail": ": If Cupid has 8 stacks of Lovestruck, the hearts also provide a temporary Strength and Intelligence buff."
                    }
                  ]
                },
                {
                  "text": "Flutter",
                  "items": [
                    {
                      "text": "Dash forward quickly, gaining an Attack Speed buff and leaving behind a trail that lasts for 6s."
                    },
                    {
                      "text": "New Feature",
                      "bold": true,
                      "detail": ": The trail provides Movement Speed and Attack Speed to all allies standing on it."
                    }
                  ]
                },
                {
                  "text": "Fields of Love",
                  "items": [
                    {
                      "text": "Fire a volley of arrows in an area, Slowing and Crippling all enemies inside. The arrows grow for 2s before exploding, dealing damage and Mesmerizing all enemies hit."
                    },
                    {
                      "text": "New Feature",
                      "bold": true,
                      "detail": ": Allies inside the area during the explosion are healed."
                    },
                    {
                      "text": "New Feature",
                      "bold": true,
                      "detail": ": If Cupid has 8 stacks of Lovestruck, the explosion Stuns instead of Mesmerizes."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
