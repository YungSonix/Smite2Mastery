    {
      "title": "Patch 11/27/24",
      "anchor": "Patch_11/27/24",
      "level": 2,
      "subsections": [
        {
          "title": "Bug Fixes",
          "anchor": "Bug_Fixes_2",
          "level": 3,
          "content": [
            {
              "type": "list",
              "items": [
                {
                  "text": "General",
                  "bold": true,
                  "items": [
                    {
                      "text": "Fixed an issue with movement speed effects over time not applying across all movement speed debuff abelites."
                    },
                    {
                      "text": "Fixed chat box for VGS having inconsistent scrolling"
                    },
                    {
                      "text": "Fixed Berserker Setting Vote control binds were incorrect in-game"
                    },
                    {
                      "text": "Fixed Auto Build setting not applying correctly in the select lobby"
                    }
                  ]
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Cupid",
                  "bold": true,
