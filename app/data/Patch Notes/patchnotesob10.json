    {
      "title": "General",
      "anchor": "General",
      "level": 2,
      "content": [
        {
          "type": "list",
          "items": [
            {
              "text": "Account Boosters",
              "items": [
                {
                  "text": "Account Boosters are now available for purchase in the Store!"
                },
                {
                  "text": "Purchasing an Account Booster grants you the following for 30 days",
                  "items": [
                    {
                      "text": "100% Account XP"
                    },
                    {
                      "text": "25% Worshiper Gain"
                    },
                    {
                      "text": "25% Wandering Market XP Gain"
                    },
                    {
                      "text": "Team Benefits (per teammate)",
                      "items": [
                        {
                          "text": "25% Account XP"
                        },
                        {
                          "text": "5% Worshiper Gain"
                        },
                        {
                          "text": "5% Wandering Market XP Gain"
                        },
                        {
                          "text": "Stackable! If multiple teammates have an active boost, the bonuses add up for everyone!"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "God Builder",
              "items": [
                {
                  "text": "Players can now Copy an existing Build for one God to another God"
                },
                {
                  "text": "Filters have been added to the God Builder page to better sort Items by Stat type"
                }
              ]
            },
            {
              "text": "Console Specific HUD",
              "items": [
                {
                  "text": "A new Console specific HUD layout has been added to the options menu. You can select this layout in the Setting menu under the UI tab"
                }
              ]
            },
            {
              "text": "Audio",
              "items": [
                {
                  "text": "An option has been added for Quip and Ambient Map sound volume"
                }
              ]
            }
          ]
        }
      ],
