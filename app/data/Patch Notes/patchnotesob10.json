  "sections": [
    {
      "title": "New Ported God",
      "anchor": "New_Ported_God",
      "level": 2,
      "content": [
        {
          "type": "list",
          "items": [
            {
              "text": "Apollo",
              "bold": true,
              "items": [
                {
                  "text": "General",
                  "items": [
                    {
                      "text": "Ranged Basic Attacks"
                    },
                    {
                      "text": "Damage Type: Physical"
                    },
                    {
                      "text": "Scaling Type: Strength Scaling"
                    }
                  ]
                },
                {
                  "text": "Passive: Audacity",
                  "items": [
                    {
                      "text": "Gain a stack of Audacity for each successful Basic Attack on an enemy and for each successful damaging ability on Enemy gods. At 10 stacks you gain 100% Attack Speed and Increased Basic Attack Projectile Speed for his next 5 Basic Attacks."
                    }
                  ]
                },
                {
                  "text": "Ability 1: So Beautiful",
                  "items": [
                    {
                      "text": "Send a projectile forward that deals Physical Damage."
                    }
                  ]
                },
                {
                  "text": "Ability 2: Serenade",
                  "items": [
                    {
                      "text": "Sing to mesmerize all nearby enemies and gain additional protections.",
                      "items": [
                        {
                          "text": "Any damage done breaks the Mesmerize"
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "Ability 3: The Moves",
                  "items": [
                    {
                      "text": "Dash forward dealing Physical Damage and Knocking aside all enemies. At the end of the Dash all nearby allies gain a Speed Buff and all nearby enemies are Slowed",
                      "items": [
                        {
                          "text": "Any enemy hit provides 1 stack of Audacity."
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "Ultimate Ability: Across the Sky",
                  "items": [
                    {
                      "text": "Ride your chariot across the sky, choosing when to land. When descending you deal Physical Damage every 0.15s for 0.6s, knocking back enemies on the last tick.",
                      "items": [
                        {
                          "text": "2 Allies can join the Chariot ride by interacting with his takeoff location. Allies have until Apollo reaches max height to join."
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "Aspect releasing May 23:",
                  "items": [
                    {
                      "text": "Aspect of Harmony",
                      "items": [
                        {
                          "text": "Audacity now grants free So Beautiful casts but no Attack Speed. So Beautiful scales with Item Health, lowers enemy Attack Speed, and grants nearby allies Attack Speed on God or Boss hits, but deals less Base Damage. Serenade now shields nearby allies but applies no Protections. Buffing an ally grants an Audacity stack."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "subsections": []
    },
    {
      "title": "New Wandering Market Traveler - Land Shark",
      "anchor": "New_Wandering_Market_Traveler_-_Land_Shark",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Sobek is here to tell you, “Land or Sea, no one is safe from me!” Unlock JAW-esome cosmetics in this new Premium Traveler Page!"
        },
        {
          "type": "paragraph",
          "text": "Contents"
        },
        {
          "type": "list",
          "items": [
            {
              "text": "Classic Land Shark Sobek Skin - Instantly unlocked after purchasing the Premium Traveler Page"
            },
            {
              "text": "Premium Page Contents - Unlock the following items with Wandering Market Coins",
              "items": [
                {
                  "text": "Land Shark - Orca Black Prism"
                },
                {
                  "text": "Land Shark - Goldfish Orange Prism"
                },
                {
                  "text": "Land Shark - Tubular Teal Prism"
                },
                {
                  "text": "Testing the Waters Jump Stamp"
                },
                {
                  "text": "Deepbite Charm Badge"
                }
              ]
            }
          ]
        }
      ],
      "subsections": []
    },
