    {
      "title": "Gameplay",
      "anchor": "Gameplay",
      "level": 2,
      "content": [
        {
          "type": "list",
          "items": [
            {
              "text": "Pele",
              "items": [
                {
                  "text": "Aspect of Obsidian - Releasing June 6",
                  "items": [
                    {
                      "text": "You only gain Fuel from Pyroclast and when damaged by enemies instead of over time. Magma Rush can no longer be refired but now provides Healing. Additionally Everlasting Flame now provides Protections instead of Strength and Lifesteal, and Volcanic Lightning damage no longer has Strength Scaling."
                    }
                  ]
                }
              ]
            },
            {
              "text": "Baron Samedi",
              "items": [
                {
                  "text": "Aspect of Hysteria - Releasing June 9",
                  "items": [
                    {
                      "text": "Hysteria applied over max deals damage. Max Hysteria no longer reduces damage. Consign Spirits only heals Baron. Vivid Gaze bonus now grants Hysteria over time, but no debuff.  Wrap It Up explosion and DoT apply Bonus Hysteria, but the explosion no longer Mesmerizes. Your personal Brew can be thrown every 20s."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "subsections": []
    },
