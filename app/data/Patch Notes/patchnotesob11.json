    {
      "title": "New Ported God",
      "anchor": "New_Ported_God",
      "level": 2,
      "content": [
        {
          "type": "list",
          "items": [
            {
              "text": "Scylla",
              "bold": true,
              "items": [
                {
                  "text": "General",
                  "items": [
                    {
                      "text": "Ranged Basic Attacks"
                    },
                    {
                      "text": "Damage Type: Magical"
                    },
                    {
                      "text": "Scaling Type: Intelligence Scaling"
                    }
                  ]
                },
                {
                  "text": "Passive: Quick Learner",
                  "items": [
                    {
                      "text": "Your abilities gain an additional effect at max rank. In addition, gain Intelligence and Mana Regen for each max rank ability"
                    }
                  ]
                },
                {
                  "text": "Ability 1: Sic ‘Em",
                  "items": [
                    {
                      "text": "Send two hounds forward, Rooting, Crippling, and dealing Magical Damage",
                      "items": [
                        {
                          "text": "At max rank, the two closest enemies to the first target will also be hit"
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "Ability 2: Crush",
                  "items": [
                    {
                      "text": "Creates a magical field that Slows enemies. After 5s it detonates, dealing Magical Damage",
                      "items": [
                        {
                          "text": "At max rank, enemies in the area also have their Magical Protection reduced and the field persists if detonated early"
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "Ability 3: Sentinel",
                  "items": [
                    {
                      "text": "Summon a sentinel at the target area, granting vision of enemies for 5s. Reactivate the ability to Leap to the sentinel location and gain a buff that causes your next Basic Attack to deal Magical Damage",
                      "items": [
                        {
                          "text": "At max rank, hitting an enemy god with the empowered Basic Attack reduces your active ability cooldowns"
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "Ultimate Ability: I’m a Monster",
                  "items": [
                    {
                      "text": "Become CC Immune for the next 6s, and gain Movement Speed. Reactivate to deal Magical Damage at the target area",
                      "items": [
                        {
                          "text": "If you kill an enemy god with the attack, the duration resets and you may attack again."
                        },
                        {
                          "text": "Whenever this ability deals damage to enemy gods you gain 1 stack, killing enemy gods provides 3. At max rank, each stack provides bonus damage to this ability."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "subsections": []
    },
