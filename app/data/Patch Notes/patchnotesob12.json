    {
      "title": "New Ported God",
      "anchor": "New_Ported_God",
      "level": 2,
      "content": [
        {
          "type": "list",
          "items": [
            {
              "text": "Ganesha",
              "bold": true,
              "items": [
                {
                  "text": "General",
                  "items": [
                    {
                      "text": "Melee Basic Attacks"
                    },
                    {
                      "text": "Damage Type: Magical"
                    },
                    {
                      "text": "Scaling Type: Intelligence Scaling"
                    }
                  ]
                },
                {
                  "text": "Passive: Good Fortune",
                  "items": [
                    {
                      "text": "Anytime you deal a killing blow, the nearest allied god receives the credit and you receive the rewards for an assist instead plus a bonus amount of gold. In addition, your assist range and the time before you lose assist credit is increased."
                    }
                  ]
                },
                {
                  "text": "Ability 1: Turn of Fate",
                  "items": [
                    {
                      "text": "Send a curse forward dealing Magical Damage to enemies it passes through. For each enemy hit, all nearby allied gods gain Bonus Damage.",
                      "items": [
                        {
                          "text": "Enemy gods are marked for 5s. Any Hard Crowd Control effect consumes the mark to deal bonus Magical Damage."
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "Ability 2: Ohm",
                  "items": [
                    {
                      "text": "Rise into the lotus position Silencing enemies in front of you and increasing Protections of nearby allied gods.",
                      "items": [
                        {
                          "text": "Ganesha gains an additional 50% of the protections he provides"
                        },
                        {
                          "text": "You are Displacement Immune while channeling"
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "Ability 3: Remove Obstacles",
                  "items": [
                    {
                      "text": "Dash forward dealing Magical Damage to enemy minions you pass through stopping on enemy gods, holding them in place before Knocking them Up.",
                      "items": [
                        {
                          "text": "While Dashing you pass through ultimate player made walls and destroy non-ultimate player made walls."
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "Ultimate Ability: Dharmic Pillars",
                  "items": [
                    {
                      "text": "Summon 4 Great Pillars to imprison your enemies. Enemies that pass the field between each pillar take an initial hit of Magical Damage, are Slowed, and have their Protections reduced.",
                      "items": [
                        {
                          "text": "Enemies continue to take Magical Damage if they stay in the field"
                        },
                        {
                          "text": "Minions take 40% reduced damage from this ability"
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "Aspect releasing June 20",
                  "items": [
                    {
                      "text": "Aspect of the Triumphant",
                      "items": [
                        {
                          "text": "Ohm no longer silences but deals damage to enemies in front of you and provides yourself and allies Movement Speed. Turn of Fate’s mark now only procs the next time you hit the marked enemy with an ability. Additionally you no longer bestow kills to allies but each god kill provides permanent Cooldown Rate."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "subsections": []
    },
