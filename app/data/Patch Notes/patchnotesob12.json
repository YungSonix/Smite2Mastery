          "type": "list",
          "items": [
            {
              "text": "Scylla",
              "items": [
                {
                  "text": "Aspect of the Devourer - Releasing June 23",
                  "items": [
                    {
                      "text": "Your non-ultimate abilities now provide Mana when damaging enemies, instead of spending it. I’m a Monster can only be used when at full Mana, consuming all of it. It no longer provides Movement Speed, but now can be fired up to 3 times and the damage scales from your Max Mana. I’m a Monster stacks now immediately provide Max Mana and at max rank you gain bonus Mana."
                    }
                  ]
                }
              ]
            },
            {
              "text": "Thor’s ability targeters have received a visual upgrade"
            },
            {
              "text": "Odin’s ability targeters have received a visual upgrade"
            }
          ]
        }
      ],
