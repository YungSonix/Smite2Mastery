    {
      "title": "Game Modes",
      "anchor": "Game_Modes",
      "level": 2,
      "content": [
        {
          "type": "list",
          "items": [
            {
              "text": "Conquest",
              "items": [
                {
                  "text": "Jungle XP Changes"
                },
                {
                  "text": "Junglers were gaining XP at a much higher rate than the other lanes, oftentimes resulting in up to two level advantages just from jungle farm alone.",
                  "items": [
                    {
                      "text": "Reduced base XP on Elder Harpies from 80 to 74"
                    },
                    {
                      "text": "Reduced base XP on Small Harpies from 20 to 14"
                    },
                    {
                      "text": "Reduced base XP on Roaming Harpies from 58 to 50"
                    }
                  ]
                },
                {
                  "text": "Lane XP Changes"
                },
                {
                  "text": "Due to the fix to the “lowest level XP split bonus” mechanic (listed below), we wanted to make sure the timing for hitting level two was still preserved.",
                  "items": [
                    {
                      "text": "Increased base XP on Melee/Brute minions from 45 to 48"
                    },
                    {
                      "text": "Increased base XP on Ranged minions from 25 to 28"
                    }
                  ]
                },
                {
                  "text": "Fixed bonus assist XP being handed out at the start of the match to players getting the lowest amount of XP"
                },
                {
                  "text": "This fix resolves the inconsistency with how players were earning XP at the start of the match.",
                  "items": [
                    {
                      "text": "This mechanic should now activate at two minutes into the match"
                    }
                  ]
                }
              ]
            },
            {
              "text": "Joust",
              "items": [
                {
                  "text": "Increased kill assist range from 12.8m to 19.2m (Smite 1 parity)"
                },
                {
                  "text": "Increased Fire Minion damage vs other Minions"
                }
              ]
            },
            {
              "text": "Assault",
              "items": [
                {
                  "text": "Yogi’s Necklace has been disabled from this game mode"
                }
              ]
            }
          ]
        }
      ],
      "subsections": []
    },
