    {
      "title": "New Ported God",
      "anchor": "New_Ported_God",
      "level": 2,
      "content": [
        {
          "type": "list",
          "items": [
            {
              "text": "Mercury",
              "bold": true,
              "items": [
                {
                  "text": "General",
                  "items": [
                    {
                      "text": "Melee Basic Attacks"
                    },
                    {
                      "text": "Damage Type: Physical"
                    },
                    {
                      "text": "Scaling Type: Strength Scaling"
                    }
                  ]
                },
                {
                  "text": "Passive: Fastest God Alive",
                  "items": [
                    {
                      "text": "For every 1cm traveled, gain 0.04% bonus damage on next Basic Attack (max 20%)"
                    },
                    {
                      "text": "Gain Strength equal to 25% of Movement Speed from items or abilities"
                    }
                  ]
                },
                {
                  "text": "Ability 1: Made You Look",
                  "items": [
                    {
                      "text": "Instantly move and deal Physical Damage in a target area"
                    },
                    {
                      "text": "Can Critically Hit, apply Ability and Basic Attack Item effects"
                    }
                  ]
                },
                {
                  "text": "Ability 2: Maximum Velocity",
                  "items": [
                    {
                      "text": "Passive: Increased Movement Speed"
                    },
                    {
                      "text": "Active: Gain Attack Speed, cleanse Slows, and gain Slow immunity"
                    }
                  ]
                },
                {
                  "text": "Ability 3: Special Delivery",
                  "items": [
                    {
                      "text": "Dash forward, knock minions aside, and grab first enemy god"
                    },
                    {
                      "text": "Deals Physical Damage over time and throws the god at the end"
                    }
                  ]
                },
                {
                  "text": "Ultimate Ability: Sonic Boom",
                  "items": [
                    {
                      "text": "Charge a long-range dash, then deal Physical Damage and spin enemies"
                    },
                    {
                      "text": "Gain Movement Speed based on charge time"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "subsections": []
    },
