    {
      "title": "Hotfix 7/1/25",
      "anchor": "Hotfix_7/1/25",
      "level": 2,
      "content": [
        {
          "type": "list",
          "items": [
            {
              "text": "Fixed an issue where Mercury could use Special Delivery (3) while Rooted/Crippled"
            },
            {
              "text": "Fixed an issue where Cripples would stop Mercury's Sonic Boom (4)"
            },
            {
              "text": "Sonic Boom (4) is now less sensitive to colliding with world geometry"
            },
            {
              "text": "Fixed issues with Obsidian Shard, Demon Blade, Stone of Binding, and Hastened Fatalis not applying their stats/effects"
            }
          ]
        }
      ],
      "subsections": []
    },
    {
      "title": "Hotfix 7/3/25",
      "anchor": "Hotfix_7/3/25",
      "level": 2,
      "content": [
        {
          "type": "list",
          "items": [
            {
              "text": "Reduced the level requirement to play Classic Queues from 10 to 5"
            },
            {
              "text": "Reduced the amount of Tickets in Quickplay Arena from 400 to 350"
            },
            {
              "text": "Resolved multiple issues on PC for players using mixed inputs (Controller + Mouse & Keyboard)"
            },
            {
              "text": "Rama Fix/Buff - Rama's Basic Attacks while using Astral Strike (1) should now knockback minions directly backwards, rather than left or right if the projectile hit them off center"
            },
            {
              "text": "Disabled the ability to beads during Aladdin's Ultimate channel/stasis. This fixes an issue where you could use beads and they would not do anything but still go on cooldown"
            },
            {
              "text": "Mercury's Made You Look (1) now scales off 70% Basic Attack Damage rather than 70% Strength (this means the ability will deal more damage always)"
            },
            {
              "text": "Fixed several crash cases"
            },
            {
              "text": "Fixed an issue where the Joust Teleporter was disabled for the first 10 minutes of a match"
            },
            {
              "text": "Fixed an issue on the Assault map where there were large areas with unintentional blue lighting"
            },
            {
              "text": "Added Sound FX to the new Queue Screen"
            },
            {
              "text": "Fixed an issue where Mercury's basic Attacks could get desynced when using Maximum Velocity (2) mid attack chain"
            },
            {
              "text": "Fixed an issue where sometimes minions would \"moonwalk\" and behave in an unintended way"
            },
            {
              "text": "Adjusted Combat Dodge in Quickplay to better match jump animations"
            },
            {
              "text": "Fixed an issue where Mercury's Maximum Velocity (2) was making him root immune"
            },
            {
              "text": "Fixed an issue where Mercury's Special Delivery (3) was not knockup immune"
            },
            {
              "text": "Fixed an issue where Mercury could get stuck in a \"spinning\" animation state after using Special Delivery (3)"
            },
            {
              "text": "Fixed an issue where Mercury's Passive was buffing the Strength contribution to his empowered Basic Attack"
            },
            {
              "text": "Fixed an issue where Global Emotes were appearing too large for players using Action Cam"
            },
            {
              "text": "Fixed an issue where Awilix could no longer summon Suku if she died to Mercury's Special Delivery (3) while on Suku"
            },
            {
              "text": "Fixed an issue where the Mouse cursor was not showing up on Xbox"
            }
          ]
        }
      ],
      "subsections": []
    },
    {
      "title": "Hotfix 7/11/25",
      "anchor": "Hotfix_7/11/25",
      "level": 2,
      "content": [
        {
