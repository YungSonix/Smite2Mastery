    {
      "title": "New Ported God",
      "anchor": "New_Ported_God",
      "level": 2,
      "subsections": [
        {
          "title": "Janus",
          "anchor": "Janus",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "General"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Ranged Basic Attacks",
                  "items": [
                    {
                      "text": "Damage Type: Magical"
                    },
                    {
                      "text": "Scaling Type: Intelligence Scaling"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Passive: Passages"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "When you pass through a Portal or Threshold, your next ability deals bonus Magical Damage."
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Smite 2 +1’s"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Now stacks up to 2 times."
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Ability 1: Portal"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Open a portal on a surface."
                },
                {
                  "text": "Wall portals create a passage to the other side for yourself."
                },
                {
                  "text": "Ground portals Banishes you and enemies upwards, dealing Magical Damage to enemies on landing."
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Ability 2: Unstable Vortex"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Launch two linked portals, dealing Magical Damage to enemies in their path."
                },
                {
                  "text": "Hitting an enemy with both portals deals bonus Magical Damage."
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Ability 3: Threshold"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Unleash a rift that Slows enemies and grants Movement Speed to allies who cross it."
                },
                {
                  "text": "Slowed enemies are Phased, causing your abilities to deal bonus Magical Damage."
                },
                {
                  "text": "Passive: You and allies also gain stacking Movement Speed when crossing the rift or passing through a portal."
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Smite 2 +1’s"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Magical Damage Janus deals to Phased enemies ignore 25% of their Magical Protection."
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Ultimate Ability: Through Space and Time"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Fire a global projectile that deals Magical Damage and opens portals for allies on any surface it passes."
                },
                {
                  "text": "You are CC Immune while firing."
                },
                {
                  "text": "Damage increases with distance traveled."
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Smite 2 +1’s"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Can now be used while falling from Portal, allowing you to exit the self banish early."
                },
                {
                  "text": "No longer has a maximum range at which it stops making new Portals."
                },
                {
                  "text": "No longer has a Maximum Health Damage Cap."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "New Wandering Market Travelers",
      "anchor": "New_Wandering_Market_Travelers",
      "level": 2,
      "subsections": [
        {
          "title": "G.E.B. 1 Traveler",
          "anchor": "G.E.B._1_Traveler",
          "level": 3,
          "content": [
            {
              "type": "list",
              "items": [
                {
                  "text": "System: online. Directive: downloaded. Target: acquired! Go into hyperdrive with the G.E.B. 1 Traveler in SMITE 2!"
                },
                {
                  "text": "Contents",
                  "bold": true,
                  "items": [
                    {
                      "text": "Classic G.E.B. 1 Geb Skin - Instantly unlocked after purchasing the Premium Traveler Page."
                    },
                    {
                      "text": "Premium Page Contents",
                      "bold": true,
                      "lead": "- Unlock the following items with Wandering Market Coins:",
                      "items": [
                        {
                          "text": "G.E.B. 1 - Stealth Strike Prism"
                        },
                        {
                          "text": "G.E.B. 1 - Combat Camo Prism"
                        },
                        {
                          "text": "G.E.B. 1 - Ultra Core Prism"
                        },
                        {
                          "text": "Mech Step Jump Stamp"
                        },
                        {
                          "text": "G.E.B. Squadron 1 Ward Skin"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Plushie Traveler",
          "anchor": "Plushie_Traveler",
          "level": 3,
          "content": [
            {
              "type": "list",
              "items": [
                {
                  "text": "Ganesha is here to spread the love! Dish out some cute and cuddly crowd control with the Plushie Traveler and build out your toy collection with every color of the Rainbow!"
                },
                {
                  "text": "Contents",
                  "bold": true,
                  "items": [
                    {
                      "text": "Classic Plushie Ganesha Skin - Instantly unlocked after purchasing the Premium Traveler Page."
                    },
                    {
                      "text": "Premium Page Contents",
                      "bold": true,
                      "lead": "- Unlock the following items with Wandering Market Coins:",
                      "items": [
                        {
                          "text": "Plushie - Red Prism"
                        },
                        {
                          "text": "Plushie - Orange Prism"
                        },
                        {
                          "text": "Plushie - Yellow Prism"
                        },
                        {
                          "text": "Plushie - Green Prism"
                        },
                        {
                          "text": "Plushie - Indigo Prism"
                        },
                        {
                          "text": "Plushie - Violet Prism"
                        },
                        {
                          "text": "The More You Know! Global Emote"
                        },
                        {
                          "text": "Rainbow Warrior Title"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "Quality of Life and New Player Improvements",
      "anchor": "Quality_of_Life_and_New_Player_Improvements",
      "level": 2,
      "content": [
        {
          "type": "list",
          "items": [
            {
              "text": "Starting in Open Beta 16, Ultimate Founder’s Edition owners will unlock all current and future Ascension Passes forever!",
              "items": [
                {
                  "text": "If you already own the Ultimate Founder’s Edition you’ll receive this new benefit immediately when you log in after the Update."
                }
              ]
            },
            {
              "text": "Ultimate Founder’s Edition owners will be refunded 900 Legacy Gems for each Ascension Pass they purchased before the Update."
            },
            {
              "text": "Purchasing Wandering Market Travelers, Collections, and Sagas now also grants bonus levels that reward double Wandering Market coins!",
              "items": [
                {
                  "text": "Bonus Coins will be granted retroactively to existing owners!"
                },
                {
                  "text": "Classic Travelers grant 5 levels of Double Coins."
                },
                {
                  "text": "Premium Travelers grant 10 levels of Double Coins."
                },
                {
                  "text": "Sagas grant 20 levels of Double Coins."
                }
              ]
            },
            {
              "text": "A new animation has been added to nameplates/health bars when an enemy God is slain to give better feedback and clarity on when an enemy has died."
            },
            {
              "text": "New Short ability descriptions have been added to both the Ability Icons on the HUD as well as the Control Screen.",
              "items": [
                {
                  "text": "Ability Icon descriptions are one word that quickly communicate what the Ability does. This text will update for Aspects and multi-stage abilities. These are on by default and can be turned off by going to Settings > UI > and toggling the “Show Short Ability Descriptor” option."
                },
                {
                  "text": "Descriptions on the Control screen are three to four words that give a little extra detail on what each Ability does after the Ability name."
                }
              ]
            },
            {
              "text": "Item Pips have been added to both the Item shop and your Item loadout on the HUD to better indicate if an item is a Tier 1, 2, or 3."
            },
            {
              "text": "The Quickplay item buying flow has received a visual update!",
              "items": [
                {
                  "text": "It is now centered on your screen."
                },
                {
                  "text": "New UI art has been added."
                },
                {
                  "text": "Item options now have an outer glow that indicates what type of Item it is."
                }
              ]
            },
            {
              "text": "Basic Attack Sound Effects have been revised for Agni, Anhur, and Aphrodite.",
              "items": [
                {
                  "text": "Agni’s Basic Attacks now have a projectile sound."
                }
              ]
            },
            {
              "text": "Conquest has received a first pass on updated lighting. This is an ongoing project, and the team will continue to make changes in future updates."
            }
          ]
        }
      ],
      "subsections": []
    },
    {
      "title": "Game Modes",
      "anchor": "Game_Modes",
      "level": 2,
      "subsections": [
        {
          "title": "NEW - Quickplay Joust",
          "anchor": "NEW_-_Quickplay_Joust",
          "level": 3,
          "content": [
            {
              "type": "list",
              "items": [
                {
                  "text": "Joust has been added as a Quickplay mode complete with all the features in Quickplay Arena:",
                  "items": [
                    {
                      "text": "Faster Gold and XP Spooling."
                    },
                    {
                      "text": "Agility Relic selected by default."
                    },
                    {
                      "text": "Draft Buy Item Building."
                    }
                  ]
                },
                {
                  "text": "We’ll be testing Quickplay Joust as the default mode for new players in this Update."
                }
              ]
            }
          ]
        },
        {
          "title": "Conquest",
          "anchor": "Conquest",
          "level": 3,
          "content": [
            {
              "type": "list",
              "items": [
                {
                  "text": "Totem of Ku",
                  "bold": true,
                  "items": [
                    {
                      "text": "NEW: Now takes 50% less damage from Gods outside of its radius."
                    },
                    {
                      "text": "REMOVED: Reward no longer grants +1 Cooldown Rate per kill."
                    },
                    {
                      "text": "NEW: Reward is now a +10 Cooldown Rate and +2 Mana Regen buff for 60 seconds, plus immediately refunds 15% Cooldown on all abilities."
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Fire Imps"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "REMOVED: The loose Nuggets in Fire Giant Pit have been removed."
                },
                {
                  "text": "NEW: An additional Fire Imp now spawns that also drops 2 Nuggets."
                },
                {
                  "text": "Decreased base Max Health: 1800 -> 1200."
                },
                {
                  "text": "Decreased base Strength: 32 -> 24."
                },
                {
                  "text": "Decreased base Protections: 32.5 -> 26."
                },
                {
                  "text": "Decreased XP Reward: 125 -> 80."
                },
                {
                  "text": "Decreased Gold Reward: 80 -> 50."
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Fire Giant Door"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "NEW: The door will now remain open until the Fire Giant spawns at 15 minutes."
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Pyromancer"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Now has an Objective Health Bar."
                }
              ]
            }
          ]
        }
      ]
    },
