    {
      "title": "New Ported God",
      "anchor": "New_Ported_God",
      "level": 2,
      "subsections": [
        {
          "title": "Jormungandr",
          "anchor": "Jormungandr",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "General"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Ranged Basic Attacks: Basic Attacks proc item hit effects for 40% damage and 20% healing."
                },
                {
                  "text": "Damage Type: Magical"
                },
                {
                  "text": "Scaling Type: Intelligence & Strength Scaling"
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Passive: Immovable"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "You are immune to Hard Displacement, but are instead dazed, a debuff that slows you and increases the damage you take."
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Ability 1: Venomous Haze"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Fire a noxious spit at an area dealing Magical Damage and creating a toxic cloud that persists."
                },
                {
                  "text": "While within the cloud, you gain extra cooling for your basic attacks"
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Ability 2: Consuming Bellow"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Channel briefly, drawing power from nearby toxic clouds, then roar to deal Magical Damage, Slow, and Tremble enemies around you."
                },
                {
                  "text": "Each cloud empowers you and the roar, increasing the size and causing it to deal bonus Magical Damage per cloud."
                },
                {
                  "text": "While Empowered, your Basic Attacks fire at their maximum rate."
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Ability 3: Submerge"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Submerge into the ground, becoming Stealthed and gaining Movement Speed. Reactivating to emerge, Knocking Up and dealing Magical Damage to enemies."
                },
                {
                  "text": "While submerged, you pulse out a ring, gaining vision of enemies"
                },
                {
                  "text": "Emerging through a toxic cloud creates two new clouds"
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Ultimate Ability: The World Serpent"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Enter into the world before diving up to three times across the battlefield. Each time you Submerge you deal Magical Damage to enemies hit."
                },
                {
                  "text": "Emerging out of the ground and your body crashing down, deals Magical Damage to enemies hit."
                },
                {
                  "text": "Each time you emerge and submerge, you Knock Up enemies and leave behind a low duration toxic cloud."
                },
                {
                  "text": "You are CC immune during this ability."
                }
              ]
            }
          ]
        }
      ]
    },
