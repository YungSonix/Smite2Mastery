    {
      "title": "Gameplay",
      "anchor": "Gameplay",
      "level": 2,
      "subsections": [
        {
          "title": "Conquest",
          "anchor": "Conquest",
          "level": 3,
          "content": [
            {
              "type": "list",
              "items": [
                {
                  "text": "Fire Imps",
                  "items": [
                    {
                      "text": "Are now considered bosses.",
                      "items": [
                        {
                          "text": "Basically make this more approachable for solo laners, less required by the jungler."
                        },
                        {
                          "text": "Decreased base Max Health from 1200 to 700"
                        },
                        {
                          "text": "Decreased base Physical Power from 24 to 18"
                        },
                        {
                          "text": "Decreased base Protections from 26 to 22"
                        },
                        {
                          "text": "Decreased base XP reward from 80 to 70"
                        },
                        {
                          "text": "Decreased base Gold reward from 50 to 40"
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "Jungle Monsters",
                  "items": [
                    {
                      "text": "Adjusted when they can attack to be after three attacks."
                    }
                  ]
                },
                {
                  "text": "Lane Minion Proxy Protection is now disabled after 5 minutes"
                }
              ]
            }
          ]
        }
      ]
    },
