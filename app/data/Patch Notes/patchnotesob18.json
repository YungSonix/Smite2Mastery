    {
      "title": "New Ported God",
      "anchor": "New_Ported_God",
      "level": 2,
      "subsections": [
        {
          "title": "Tsukuyomi",
          "anchor": "Tsukuyomi",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "General"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Melee Basic Attacks"
                },
                {
                  "text": "Damage Type: Physical & Magical"
                },
                {
                  "text": "Scaling Type: Strength & Intelligence Scaling"
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Passive: Shingetsu & Mangetsu"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Damaging enemies empowers your twin tonfas, Shingetsu and Mangetsu",
                  "items": [
                    {
                      "text": "Empowered Shingetsu cleaves and restores mana"
                    },
                    {
                      "text": "Empowered Mangetsu deals bonus damage and restores health"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Ability 1: Dark Moon Shuriken"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Throw a shuriken that deals physical damage to enemies and sticks into the first god hit",
                  "items": [
                    {
                      "text": "Retrieving the shuriken from a god reduces the abilities cooldown"
                    },
                    {
                      "text": "After casting, your next Shingetsu attack becomes a ranged attack that steals movement speed."
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Ability 2: Kusarigama"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Perform a three-swing combo with Kusarigama. The first two swings deal damage and disarm enemies. The final swing deals more damage."
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Ability 3: Silver Moon Caltrops"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Scatter Caltrops in an area, dealing damage and slowing enemies"
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Ultimate Ability: Piercing Moonlight"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Fire 4 piercing beams of moonlight, marking and dealing damage to enemy gods.",
                  "items": [
                    {
                      "text": "After firing, dash through all marked gods in order dealing damage with each strike."
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Aspect releasing Mangetsu - Released 12th September"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "When gaining Shingetsu ranged attack, they become Magnetsu ranged attacks instead. Dark Moon Shuriken no longer sticks to gods. Piercing Moonlight hits each target only once for major damage in an AOE, before returning to his casting location."
                }
              ]
            }
          ]
        }
      ]
    },
