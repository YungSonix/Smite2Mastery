    {
      "title": "New Item Slot",
      "anchor": "New_Item_Slot",
      "level": 2,
      "subsections": [
        {
          "title": "Curio",
          "anchor": "Curio",
          "level": 3,
          "content": [
            {
              "type": "list",
              "items": [
                {
                  "text": "Curios are mode-specific items that everyone in that mode has access to. These don’t take up a standard inventory slot and function more like the bonus Starter Item slot. They are automatically granted to players and do not require a purchase."
                },
                {
                  "text": "Items in the Curio Slot are actives that occupy an active item slot.",
                  "items": [
                    {
                      "text": "If you attempt to buy a third Active Item, the Curio slot will disable, allowing the third Active Item to take its place."
                    },
                    {
                      "text": "It will default to the second Active slot for keybind purposes. You can move it to any slot utilizing the existing reordering tools."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
