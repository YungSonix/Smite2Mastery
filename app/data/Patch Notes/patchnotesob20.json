    {
      "title": "Quality of Life and New Player Improvements",
      "anchor": "Quality_of_Life_and_New_Player_Improvements",
      "level": 2,
      "content": [
        {
          "type": "list",
          "items": [
            {
              "text": "New Match Lobby",
              "items": [
                {
                  "text": "Improvements to match lobby interface, making it easier to select between Gods"
                },
                {
                  "text": "Now displays your teammates’ models as they lock in"
                }
              ]
            },
            {
              "text": "New FX for Agility relic"
            },
            {
              "text": "New FX and Audio for Curios"
            },
            {
              "text": "Music System Rework",
              "items": [
                {
                  "text": "Tracks will no longer play over each other"
                },
                {
                  "text": "Specific new logic will determine how long the Titan track plays, and what can end the music"
                }
              ]
            },
            {
              "text": "Alternate Hitmarker Sounds have been added for Crits, Ticks, and Waveclear"
            },
            {
              "text": "Code for the Profile UI has been rewritten for increased performance"
            }
          ]
        }
      ],
      "subsections": []
    },
    {
      "title": "Game Modes",
      "anchor": "Game_Modes",
      "level": 2,
      "content": [
        {
          "type": "list",
          "items": [
            {
              "text": "Conquest",
              "items": [
                {
                  "text": "Titans",
                  "items": [
                    {
                      "text": "Titans are no longer immune to damage from Critical Strikes"
                    },
                    {
                      "text": "Now take 50% less bonus damage from Crits"
                    }
                  ]
                }
              ]
            },
            {
              "text": "Ranked Conquest",
              "items": [
                {
                  "text": "Simultaneous Ranked Bans are now implemented. Each player will be able to Ban 1 God, bringing the maximum number of potential Banned Gods to 10.",
                  "items": [
                    {
                      "text": "As a result, players must now own 20 Gods to participate in Ranked Conquest"
                    }
                  ]
                }
              ]
            },
            {
              "text": "Arena and Joust",
              "items": [
                {
                  "text": "Pacing changes have been made to reduce the length of matches in these modes"
                }
              ]
            }
          ]
        }
      ],
      "subsections": []
    },
