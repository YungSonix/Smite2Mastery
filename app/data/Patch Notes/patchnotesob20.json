    {
      "title": "Hotfix 10/8/25",
      "anchor": "Hotfix_10/8/25",
      "level": 2,
      "content": [
        {
          "type": "list",
          "items": [
            {
              "text": "Fixed Ancient Fury not spawning after 3 Gold Furies have been slain,"
            },
            {
              "text": "Final texture and material edits for Ms Diagnosis Neith,"
            },
            {
              "text": "Match Lobby",
              "items": [
                {
                  "text": "Fixed being able to click on enemy portaits to see player names,"
                },
