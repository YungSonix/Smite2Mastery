    {
      "title": "Wandering Path - New Reward System",
      "anchor": "Wandering_Path_-_New_Reward_System",
      "level": 2,
      "content": [
        {
          "type": "list",
          "items": [
            {
              "text": "Wandering Path",
              "items": [
                {
                  "text": "Wandering Market Levels are now reflected on a Path, with a visible Level Number"
                },
                {
                  "text": "Each Level continues to grant Wandering Market coins at the past rate"
                },
                {
                  "text": "Every fifth level (e.g. 5, 10, 15, …) grants an additional bonus reward",
                  "items": [
                    {
                      "text": "Players can earn 300 Diamonds by completing the Path, in addition to other rewards"
                    },
                    {
                      "text": "Note: A Reaping Event Pumpkin is available at Level 55"
                    }
                  ]
                }
              ]
            },
            {
              "text": "Wandering Path Free Store",
              "items": [
                {
                  "text": "Players may spend their Wandering Market Coins to unlock:",
                  "items": [
                    {
                      "text": "New: Market Chest",
                      "items": [
                        {
                          "text": "May be rolled once per day"
                        },
                        {
                          "text": "Has a chance to roll Skins, Cosmetics, Diamonds, Boosters, Ascension Pass Tokens, Legacy Gems, or Wandering Market Coins"
                        }
                      ]
                    },
                    {
                      "text": "God Unlock Tokens (Unlimited)"
                    },
                    {
                      "text": "Classic Announcer Pack Chest (Once per Week)"
                    },
                    {
                      "text": "Classic Cutesy Chest (Once per Week)"
                    },
                    {
                      "text": "Classic Music Chest (Once per Week)"
                    },
                    {
                      "text": "Classic Skin Chest (Once per 28 Days)"
                    }
                  ]
                }
              ]
            },
            {
              "text": "Weekly Quest",
              "items": [
                {
                  "text": "A new Weekly Quest has been added to SMITE 2"
                },
                {
                  "text": "This grants Wandering Market Coins after playing 4, 8, and 16 games each week"
                }
              ]
            }
          ]
        }
      ],
      "subsections": []
    },
