    {
      "title": "New Ported God",
      "anchor": "New_Ported_God",
      "level": 2,
      "subsections": [
        {
          "title": "Sylvanus",
          "anchor": "Sylvanus",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "General"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Ranged Basic Attacks"
                },
                {
                  "text": "Damage Type: Magical"
                },
                {
                  "text": "Scaling Type: Intelligence Scaling"
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Passive: Nature's Bounty"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "When your abilities hit or are deployed, a seed pod appears. Picking it up restores Mana and reduces your cooldowns. Pickup up 8 spawns a pod near Sylvanus"
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Ability 1: Verdant Growth"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Throw a pod that deals Magical Damage, applies Protection reduction and roots enemies.",
                  "items": [
                    {
                      "text": "If it lands on the ground without hitting an enemy, it grows into a flower that grants nearby allies Mana Regeneration"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Ability 2: Wisps"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Release wisps that restore health to allies or will deal Magical Damage to enemies repeatedly over time. Allies gain Protections while healed.",
                  "items": [
                    {
                      "text": "The first wisp tick deals twice the normal amount of damage and healing"
                    },
                    {
                      "text": "Wisps can revive Wilted Flowers or cause Living Flowers to grant Protections in an aura."
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Ability 3: Nature's Grasp"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Extend a vine that Stuns the first enemy god hit and Pulls them towards Sylvanus.",
                  "items": [
                    {
                      "text": "Sylvanus can pull pods to him, granting a Mana aura. If Sylvanus drops below 40% Health he consumes the aura to gain Wisps."
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Ultimate Ability: Wrath of Terra"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Slam the ground, Knocking Up enemies in an area and dealing Magical Damage repeatedly over time.",
                  "items": [
                    {
                      "text": "If a pod has been grabbed, consume it to apply Verdant Growth’s Protection Reduction."
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Aspect releasing November 7th: Aspect of Grover’s Wrath"
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Attacks: +15% damage to targets debuffed by Sylvanus."
                },
                {
                  "text": "Wisp’s Heal, Protections and Ultimate Knockup reduced by 40%"
                },
                {
                  "text": "Nature’s Grasp tethers, dealing damage and slowing while also granting Sylvanus Haste."
                },
                {
                  "text": "Gain Anger (+Attack Speed) when Verdant Growth or an Ally dies;+2 on Ultimate cast. At 4 stacks, Enrage: +Attack Speed and a free Wisps or Nature’s Grasp cast."
                }
              ]
            }
          ]
        }
      ]
    },
