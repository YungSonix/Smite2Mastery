        },
        {
          "type": "list",
          "items": [
            {
              "text": "Stone of Binding (Shift)",
              "items": [
                {
                  "text": "“Stone of Binding felt awkward compared to its Smite 1 counterpart. Being so cheap but being combined with an Item Protection threshold to be effective made it feel awkward to build. We are increasing the cost to be able to provide more stats, making it feel better in a completed build. Additionally, we are removing the Item Protection Threshold and instead focusing the gameplay towards gods that can consistently disrupt and Crowd Control their opponents, by making each stack more impactful, straightforward, and rewarding players who can apply multiple control effects over the length of a fight.”",
                  "items": [
                    {
                      "text": "Increased Cost: 2250 -> 2550"
                    },
                    {
                      "text": "Increased Physical Protection: 25 -> 35"
                    },
                    {
                      "text": "Increased Magical Protection: 20 -> 25"
                    },
                    {
                      "text": "Decreased Stack Count: 4 -> 3"
                    },
                    {
                      "text": "Increased Protection Reduction: 5 -> 7"
                    },
                    {
                      "text": "Removed: Item Protection Threshold for 2 Stacks"
                    },
                    {
                      "text": "Increased Stack Duration: 4s -> 6s"
                    },
                    {
                      "text": "Stacks now fade off one at a time"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "list",
          "items": [
            {
              "text": "The Executioner (Buff)",
              "items": [
                {
                  "text": "Decreased Cost: 2650 -> 2550"
                }
              ]
            }
          ]
        }
      ],
