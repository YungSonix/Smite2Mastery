    {
      "title": "Game Modes",
      "anchor": "Game_Modes",
      "level": 2,
      "subsections": [
        {
          "title": "Conquest",
          "anchor": "Conquest",
          "level": 3,
          "content": [
            {
              "type": "list",
              "items": [
                {
                  "text": "Base Teleporters",
                  "items": [
                    {
                      "text": "Now automatically cancel the teleport if the Tower being teleported to is destroyed"
                    }
                  ]
                },
                {
                  "text": "Pyromancer",
                  "items": [
                    {
                      "text": "Removed the structure damage that gets dealt to the lowest Health enemy Tower when Pyromancer is slain"
                    },
                    {
                      "text": "Runic Bomb",
                      "items": [
                        {
                          "text": "Can no longer be destroyed by Basic Attacks"
                        },
                        {
                          "text": "Damage now bypasses Backdoor Protections"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Assault",
          "anchor": "Assault",
          "level": 3,
          "content": [
            {
              "type": "list",
              "items": [
                {
                  "text": "Adjusted Healer Tiers",
                  "items": [
                    {
                      "text": "“We are adjusting these based on their potential top end healing as a god; as Aspects can create big disparities.”"
                    },
                    {
                      "text": "Tier 1 (Healers with consistent and high team healing)",
                      "items": [
                        {
                          "text": "Guan Yu, Ra, Sylvanus"
                        }
                      ]
                    },
                    {
                      "text": "Tier 2 (Healers with more limited or lower overall team healing)",
                      "items": [
                        {
                          "text": "Aphrodite, Yemoja, Baron Samedi"
                        }
                      ]
                    },
                    {
                      "text": "Tier 3 (Healers with even more conditional and lower overall team healing)",
                      "items": [
                        {
                          "text": "Cupid, Eset"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Quickplay Joust",
          "anchor": "Quickplay_Joust",
          "level": 3,
          "content": [
            {
              "type": "list",
              "items": [
                {
                  "text": "Decreased Respawn Times",
                  "items": [
                    {
                      "text": "Decreased Player Respawn Multiplier : 0.65 -> 0.55"
                    },
                    {
                      "text": "Decreased Player Respawn Maximum: 30s -> 25s"
                    },
                    {
                      "text": "Decreased Respawn Minimum: 7s -> 5s"
                    },
                    {
                      "text": "Increased Respawn Duration Overtime Conversion: 60s -> 90s"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
