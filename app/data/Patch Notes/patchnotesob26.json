    {
      "title": "Quality of Life",
      "anchor": "Quality_of_Life",
      "level": 2,
      "content": [
        {
          "type": "list",
          "items": [
            {
              "text": "Curio now easier to purchase in the store"
            },
            {
              "text": "Unpause binding swapped to F5 to help prevent accidental press during vote panel"
            },
            {
              "text": "Minimap Pinging will now always center the cursor on gamepad"
            },
            {
              "text": "Agility Relic Setting - Lets you choose if you want to use the alternate shift keybind or if you want to use the standard relic keybinds"
            }
          ]
