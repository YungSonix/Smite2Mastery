                  "items": [
                    {
                      "text": "Increased Strength Scaling: 65% -> 80%"
                    },
                    {
                      "text": "Increased Strength Scaling when not facing Medusa: 55% -> 70%."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "list",
          "items": [
