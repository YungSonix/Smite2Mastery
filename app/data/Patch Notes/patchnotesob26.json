  "sections": [
    {
      "title": "New Ported God",
      "anchor": "New_Ported_God",
      "level": 2,
      "subsections": [
        {
          "title": "Discordia",
          "anchor": "Discordia",
          "level": 3,
          "content": [
            {
              "type": "list",
              "items": [
                {
                  "text": "General",
                  "bold": true,
                  "items": [
                    {
                      "text": "Ranged Basic Attacks"
                    },
                    {
                      "text": "Damage Type: Magical"
                    },
                    {
                      "text": "Scaling Type: Intelligence Scaling"
                    }
                  ]
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Passive: Contest of Gods",
                  "bold": true,
                  "items": [
                    {
                      "text": "The God on your team with the highest damage dealth to the enemy gods gains a buff of Strength and Intelligence. Gaining a level or a god kill/assist provides a random temporary buff of Intelligence, Lifesteal or Healing."
                    }
                  ]
                },
                {
                  "text": "Ability 1: Unruly Magic",
                  "bold": true,
                  "items": [
                    {
                      "text": "Fire out an orb of unruly magic dealing Magical Damage."
                    },
                    {
                      "text": "After reaching the target location, it explodes in a small area dealing Magical Damage before breaking into bouncing minor projectiles that each deal Magical Damage."
                    }
                  ]
                },
                {
                  "text": "Ability 2: Strife",
                  "bold": true,
                  "items": [
                    {
                      "text": "Create an area that deals Magical Damage"
                    },
                    {
                      "text": "Hitting one enemy causes them to be rooted, hitting multiple causes them to attack their nearest ally for Magical Damage."
                    }
                  ]
                },
                {
                  "text": "Ability 3: Erratic Behavior",
                  "bold": true,
                  "items": [
                    {
                      "text": "Leap and create a field in an area. While within the field you gain Stealth, Movement Speed and your ability cooldowns are decreased."
                    },
                    {
                      "text": "Dealing damage to enemy gods while within the field increases it’s duration"
                    }
                  ]
                },
                {
                  "text": "Ultimate Ability: Golden Apple of Discord",
                  "bold": true,
                  "items": [
                    {
                      "text": "Throw the Golden Apple of Discord which deals Magical Damage before exploding in an area dealing Magical Damage and spreading the effects of the apple."
                    },
                    {
                      "text": "Enemies afflicted by the apple effect are crippled and trembled"
                    },
                    {
                      "text": "Enemies caught in the explosion take initial damage and a burst of damage at the end of the effect, but do not explode in an area"
                    }
                  ]
                },
                {
                  "text": "Aspect releasing 16th January",
                  "bold": true,
                  "items": [
                    {
                      "text": "Aspect of the Gilded Victor",
                      "bold": true,
                      "items": [
                        {
                          "text": "Contest of Gods only provides you extra Attack Damage from Intelligence. Unruly Magic does not explode but returns back, dealing damage and providing a stack causing your next attacks to explode. Erratic Behavior no longer creates a field of stealth but attack speed and attack damage. Golden Apple of Discord is faster and does not spread."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
