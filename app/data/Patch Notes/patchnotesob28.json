    {
      "title": "New Classic God",
      "anchor": "New_Classic_God",
      "level": 2,
      "subsections": [
        {
          "title": "Ne Zha",
          "anchor": "Ne_Zha",
          "level": 3,
          "content": [
            {
              "type": "list",
              "items": [
                {
                  "text": "General",
                  "bold": true,
                  "items": [
                    {
                      "text": "Melee Basic Attacks"
                    },
                    {
                      "text": "Damage Type: Physical"
                    },
                    {
                      "text": "Scaling Type: Strength Scaling"
                    }
                  ]
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Passive: Righteous Spirit",
                  "bold": true,
                  "items": [
                    {
                      "text": "Build Righteous Spirit stacks by hitting enemies to gain Movement Speed. Stacks reset if you have not taken or dealt damage recently.",
                      "items": [
                        {
                          "text": "Critical Strikes grant bonus stacks"
                        },
                        {
                          "text": "Stacks grant Movement Speed"
                        },
                        {
                          "text": "Gaining a stack permanently increases Critical Strike Damage."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Ability 1: Universe Ring Toss",
                  "bold": true,
                  "items": [
                    {
                      "text": "Throw your ring to deal Physical Damage which bounces between enemies, applying Physical Protection Debuff and Slows. Subsequent hits deal 35% damage",
                      "items": [
                        {
                          "text": "Catching the returning ring grants a free single ring that can Critically Strike."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Ability 2: Flaming Spear",
                  "bold": true,
                  "items": [
                    {
                      "text": "Ignite your spear to gain Attack Speed and Critical Strike chance.",
                      "items": [
                        {
                          "text": "Heal based on your Righteous Spirit Stacks."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Ability 3: Armillary Sash",
                  "bold": true,
                  "items": [
                    {
                      "text": "Throw your Armillary Sash, Stunning the first enemy god hit and pulling you to them."
                    }
                  ]
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Ultimate Ability: Wind Fire Wheels",
                  "bold": true,
                  "items": [
                    {
                      "text": "Dash forward gaining Protections and becoming CC immune. Hitting an enemy god delays Physical Damage and launches them into the air, triggering a 3-hit combo that deals Physical Damage. Successful timing can allow these to Critically Strike."
                    }
                  ]
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Aspect releasing February 13th",
                  "bold": true,
                  "items": [
                    {
                      "text": "Aspect of the Righteous Flame",
                      "bold": true,
                      "items": [
                        {
                          "text": "Righteous Spirit no longer stacks on hitting enemies. Taking damage charges Righteous Spirit to provide a heal over time. Ring Toss can bounce to allies for a movement and Attack Speed boost. Flaming Spear is now a damaging AoE attack that buffs Ne Zha’s attacks and consumes Righteous Spirit to burst heal."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
