    {
      "title": "Item Balance",
      "anchor": "Item_Balance",
      "level": 2,
      "content": [
        {
          "type": "list",
          "items": [
            {
              "text": "Blinking Abyss",
              "bold": true,
              "items": [
                {
                  "text": "Fixed: You can no longer use this item while Crippled"
                }
              ]
            },
            {
              "text": "Bumba’s Golden Dagger & Bumba’s Cudgel",
              "bold": true,
              "items": [
                {
                  "text": "Increased Minion Damage Reduction: 25% -> 40% (-1.5% Per Level)",
                  "items": [
                    {
                      "text": "Level 1: 25% -> 38.5%"
                    },
                    {
                      "text": "Level 20: 25% -> 10%"
                    }
                  ]
                }
              ]
            },
            {
              "text": "Arondight",
              "bold": true,
              "items": [
                {
                  "text": "Decreased Strength: 65 -> 55"
                }
              ]
            },
            {
              "text": "Titan’s Bane",
              "bold": true,
              "items": [
                {
                  "text": "Decreased Strength: 50 -> 40"
                }
              ]
            },
            {
              "text": "Qin’s Blade",
              "bold": true,
              "items": [
                {
                  "text": "Removed the current method for determining damage."
                },
                {
                  "text": "Removed the Anti-Heal Component on this Item."
                },
                {
                  "text": "Now deals damage based on a mixture of the targets Base Health and the targets Item Health.",
                  "items": [
                    {
                      "text": "1.5% of the Targets Base Health"
                    },
                    {
                      "text": "3% of the Targets Item Health"
                    }
                  ]
                }
              ]
            },
            {
              "text": "Soul Reaver",
              "bold": true,
              "items": [
                {
                  "text": "Removed the current method for determining damage."
                },
                {
                  "text": "Increased Intelligence: 60 -> 75"
                },
                {
