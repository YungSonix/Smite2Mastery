    {
      "title": "New Classic God",
      "anchor": "New_Classic_God",
      "level": 2,
      "subsections": [
        {
          "title": "Ratatoskr",
          "anchor": "Ratatoskr",
          "level": 3,
          "content": [
            {
              "type": "list",
              "items": [
                {
                  "text": "-Passive: Acorn of Yggdrasil",
                  "bold": true,
                  "items": [
                    {
                      "text": "You spawn with a Magic Acorn in your inventory. This can be upgraded anywhere on the map to provide different bonuses."
                    }
                  ]
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Ability 1: Dart",
                  "bold": true,
                  "items": [
                    {
                      "text": "Dash forward, dealing physical damage and slowing enemies hit, stopping on enemy gods."
                    },
                    {
                      "text": "Cooldown is reduced when dealing damage to enemy gods with other abilities, Once per ability, per God"
                    },
                    {
                      "text": "This ability can now critical strike",
                      "items": [
                        {
                          "text": "Briskberry Acorn",
                          "items": [
                            {
                              "text": "Dart is shorter, wider and now passes through enemy gods. It’s cooldown is reset on enemy god hit. It cannot be reset more than twice"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Ability 2: Flurry",
                  "bold": true,
                  "items": [
                    {
                      "text": "Spin 4 times and deal physical damage to enemies around you, reducing their physical protections.",
                      "items": [
                        {
                          "text": "Ashwhorl Acorn",
                          "items": [
                            {
                              "text": "Flurry sends out 8 acorns in a circle that freeze in the air before returning back to you, dealing physical damage and providing attack speed per enemy god hit."
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Ability 3: Acorn Blast",
                  "bold": true,
                  "items": [
                    {
                      "text": "Fire a blast of 3 acorns that deal physical damage, enemies hit by 3 acorns are stunned.",
                      "items": [
                        {
                          "text": "Thistlethorn Acorn",
                          "items": [
                            {
                              "text": "Acorn Blast fires 3 acorns that deal physical damage and stick to enemy gods or freeze at max range. After a short delay they explode dealing physical damage.",
                              "items": [
                                {
                                  "text": "Damage is no longer reduced by subsequent hits"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Ultimate Ability: Through the Cosmos",
                  "bold": true,
                  "items": [
                    {
                      "text": "Fly into the sky, choose and leap to a location up to two times before landing at a final location dealing physical damage and knocking up enemies."
                    }
                  ]
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Aspect releasing April 10th",
                  "bold": true,
                  "items": [
                    {
                      "text": "Aspect of the Thickbark",
                      "bold": true,
                      "items": [
                        {
                          "text": "Your tier 3 acorn effects change.",
                          "items": [
                            {
                              "text": "Briskberry causes Dart to knockback enemy gods, marking them to explode."
                            },
                            {
                              "text": "Ashworl provides Flurry 2 charges, protections and healing."
                            },
                            {
                              "text": "Thistlethorn causes Acorn Blast to fire 5 projectiles and debuffs enemies."
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
