    {
      "title": "Wandering Market Coin level improvements",
      "anchor": "Wandering_Market_Coin_level_improvements",
      "level": 2,
      "content": [
        {
          "type": "list",
          "items": [
            {
              "text": "Players who purchased Travelers or an Event after completing the Wandering Path could get into a situation where they were not earning Coins quickly enough to progress through their Travelers."
            }
          ]
        },
        {
          "type": "list",
          "items": [
            {
              "text": "Now, if you have Boosted Coin Levels, any Wandering Path Level will progress at the accelerated rate, even if you previously completed the Wandering Path."
            }
          ]
        }
      ],
