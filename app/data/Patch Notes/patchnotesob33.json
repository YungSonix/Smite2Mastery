  "sections": [
    {
      "title": "New Classic God",
      "anchor": "New_Classic_God",
      "level": 2,
      "subsections": [
        {
          "title": "Ishtar",
          "anchor": "Ishtar",
          "level": 3,
          "content": [
            {
              "type": "list",
              "items": [
                {
                  "text": "Passive: Mark of Vengeance",
                  "bold": true,
                  "items": [
                    {
                      "text": "When you drop below 75% Health, apply Mark of Vengeance to the enemy god that most recently damaged you for 10 seconds."
                    },
                    {
                      "text": "Each attack against the marked god grants stacking attack speed"
                    },
                    {
                      "text": "Scoring a kill or assist on the marked god grants movement speed and permanent 5 strength, up to 25."
                    }
                  ]
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Ability 1:",
                  "bold": true,
                  "lead": "Imbue Arrows",
                  "items": [
                    {
                      "text": "Imbue your arrows with heavenly light, empowering your attacks as Strike Shot, Spread Shot or Storm Shot",
                      "items": [
                        {
                          "text": "Strike Shot: Lob explosions that deal bonus area damage in an area; may fire over walls"
                        },
                        {
                          "text": "Spread Shot: Fire 5 arrows in a cone; Center hit applies on hit item effects to the target"
                        },
                        {
                          "text": "Storm SHot: Gain attack speed and fire faster, longer range shots that deal reduced damage."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Ability 2: Rolling Thunder",
                  "bold": true,
                  "items": [
                    {
                      "text": "Call down four lightning strikes in a line, dealing physical damage per strike to enemies in each area."
                    },
                    {
                      "text": "Enemies hit by more than one strike are Mesmerized"
                    }
                  ]
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Ability 3: Jolt",
                  "bold": true,
                  "items": [
                    {
                      "text": "Dash forward with your blades, dealing physical damage to enemies in your path",
                      "items": [
                        {
                          "text": "Hitting an enemy god roots them as you backflip in an area around them and can Critically strike and trigger on hit item effects."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Ultimate Ability: Blades of Retribution",
                  "bold": true,
                  "items": [
                    {
                      "text": "Become CC immune and summon five swords of light, firing out in a cone. Each sword deals physical damage and cripples enemies.",
                      "items": [
                        {
                          "text": "Refire this ability to recall the swords towards you"
                        },
                        {
                          "text": "Enemies hit by both the outgoing volley and the recall are stunned."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Aspect of the Passionate Storm - Releasing 24/4",
                  "bold": true,
                  "items": [
                    {
                      "text": "Your Spread Shot cone is always active on your attacks."
                    },
                    {
                      "text": "Imbue Arrows no longer changes stance; it grants Attack Speed and lets you build Storm’s Kiss whenever you hit a target with an attack while imbue is active."
                    },
                    {
                      "text": "Rolling Thunder now grants you a small movement speed bonus per strike."
                    },
                    {
                      "text": "Jolt Consumes Storm’s Kiss stacks on hit; at 8 or more stacks, the arrow you fire after the backflip deals bonus damage."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
