    {
      "title": "Bug Fixes",
      "anchor": "Bug_Fixes",
      "level": 2,
      "content": [
        {
          "type": "list",
          "items": [
            {
              "text": "Fatalis now properly respects Melee vs. Ranged for Gods that switch Attack type via Aspect (Cernunnos, Morgan Le Fay, Kali, Geb), and Gods that change their Attack type via ability (Athena, Tsukuyomi)."
            },
            {
              "text": "Dagger of Frenzy stacks are now expended by abilities that benefit from the attack speed (Da Ji Aspect 2, Guan Yu 3, etc.)"
            },
            {
              "text": "Ratatoskr Acorn dash will still reset if a dash kills an enemy."
            },
            {
              "text": "Added Charon passive icon to leave boat"
            },
            {
              "text": "Addressed certain prisms appearing untextured in DX11."
            },
            {
              "text": "Sylvanus 3 no longer procs Resolute Mantle and Spirit Robe on Sylvanus"
            },
            {
              "text": "Fixed issue where Charon Aspect was being hit by DoT’s."
            },
            {
              "text": "Fixed Towers sometimes being able to see and target enemy Gods behind walls if they were leaping high enough"
            }
          ]
        }
      ],
      "subsections": []
    },
    {
      "title": "Hotfix 4/22/26",
      "anchor": "Hotfix_4/22/26",
      "level": 2,
      "subsections": [
        {
          "title": "Bug Fixes",
          "anchor": "Bug_Fixes_2",
          "level": 3,
          "content": [
            {
              "type": "list",
              "items": [
                {
                  "text": "Ishtar",
                  "bold": true,
                  "items": [
                    {
                      "text": "Ishtar Imbue Arrows was causing Rolling Thunder or Jolt to fire off when used."
                    },
                    {
                      "text": "Ishtar Imbue Arrows was canceling abilities while active, and was cancelled by CC."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "Hotfix 4/23/26",
      "anchor": "Hotfix_4/23/26",
      "level": 2,
      "subsections": [
        {
          "title": "Bug Fixes",
          "anchor": "Bug_Fixes_3",
          "level": 3,
          "content": [
            {
              "type": "list",
              "items": [
                {
                  "text": "Ishtar",
                  "bold": true,
                  "items": [
                    {
                      "text": "Ishtar Strike Shot wasn't properly getting its full bonus damage."
                    },
                    {
                      "text": "Ishtar Imbue Arrows was not resetting inhand chain when leaving the stance."
                    },
                    {
                      "text": "Ishtar Jolt backfip was targetable"
                    },
                    {
                      "text": "Ishtar Jolt was sometimes going to the center of the map"
                    },
                    {
                      "text": "Ishtar Rolling Thunder deploy speed got sped up"
                    },
                    {
                      "text": "Ishtar Rolling Thunder can now fired in walls properly"
                    },
                    {
                      "text": "Ishtar Blades of Retribution wasn't stunning targets when damage was immuned"
                    },
                    {
                      "text": "Ishtar wasn't showing up in character select under the Carry role."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
