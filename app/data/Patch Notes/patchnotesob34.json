    {
      "title": "Quality of Life",
      "anchor": "Quality_of_Life",
      "level": 2,
      "content": [
        {
          "type": "list",
          "items": [
            {
              "text": "Added Audio to teleporters that only enemies and allies can hear when being used."
            },
            {
              "text": "Profile Loadout categories now have dropdown menus for better organization, making it easier to find the Profile items you are looking for."
            },
            {
              "text": "Aspects now show on the team portrait bar in-game."
            },
            {
              "text": "Improvements made to prevent attack animation desynchronizations."
            },
            {
              "text": "Tenacity has been updated to affect both Hard CC and Soft CC."
            },
            {
              "text": "Low Priority Queue Updates",
              "items": [
                {
                  "text": "Your first offense will now be a Deserter penalty, like it used to be. So there is some leniency/grace."
                },
                {
                  "text": "Your second offense will still result in Low Priority Queue"
                },
                {
                  "text": "If you have Low Priority Queue, you cannot queue for Ranked (but can queue for other modes)"
                }
              ]
            }
          ]
        }
      ],
      "subsections": []
    },
