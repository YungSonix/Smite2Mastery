    {
      "title": "God Balance",
      "anchor": "God_Balance",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Ah Puch"
        },
        {
          "type": "list",
          "items": [
            {
              "text": "Hollow Ground",
              "items": [
                {
                  "text": "Health heal reduced from 4% of max health to 3%."
                }
              ]
            },
            {
              "text": "Wraith Call",
              "items": [
                {
                  "text": "Aspect of the Death March",
                  "items": [
                    {
                      "text": "Protection Shred reduced from 1/2.5/4/5.5/7 to 1/2/3/4/5"
                    }
                  ]
                }
              ]
            },
            {
              "text": "Fleeting Breath",
              "items": [
                {
                  "text": "Damage and Scaling reduced from 30/40/50/60/70 + 20% Intelligence per tick to 24/32/40/48/56 + 16% Intelligence per tick"
                }
              ]
            },
            {
              "text": "Empty The Crypts",
              "items": [
                {
                  "text": "Damage reduced from 55/65/75/85/95 + 18% scaling to 50/58/66/74/82 + 15% Scaling"
                },
                {
                  "text": "Cooldown increased to 110s"
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "text": "Cabrakan"
        },
        {
          "type": "list",
          "items": [
            {
              "text": "General",
              "items": [
