            {
              "type": "list",
              "items": [
                {
                  "text": "Assault",
                  "items": [
                    {
                      "text": "You can now re-enter the fountain to purchase items during the Setup phase before Minions spawn."
                    }
                  ]
                },
                {
                  "text": "Duel",
                  "items": [
                    {
                      "text": "Standing in your Fountain for too long after Minions spawn will cause your Tower, Phoenix, and Titan to take continuous damage."
                    }
