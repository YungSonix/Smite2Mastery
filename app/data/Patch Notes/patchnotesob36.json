  "sections": [
    {
      "title": "New Classic God",
      "anchor": "New_Classic_God",
      "level": 2,
      "subsections": [
        {
          "title": "Horus",
          "anchor": "Horus",
          "level": 3,
          "content": [
            {
              "type": "list",
              "items": [
                {
                  "text": "Passive: Resolute",
                  "bold": true,
                  "items": [
                    {
                      "text": "Gain Resolute stacks when an enemy god damages you. Each stack grants protections and crowd control reduction for a short duration. When resolute expires, heal based on your stacks."
                    }
                  ]
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Ability 1: Updraft",
                  "bold": true,
                  "items": [
                    {
                      "text": "Create an updraft around you, dealing physical damage and knocking up nearby enemies."
                    },
                    {
                      "text": "Your next attack within a short duration, fires a gust forward, dealing physical damage and slowing enemies. Enemies already knocked up take bonus physical damage."
                    }
                  ]
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Ability 2: Fracture",
                  "bold": true,
                  "items": [
                    {
                      "text": "Dash forward, dealing physical damage, hitting an enemy god stops the dash and stuns them, then you cleave enemies in front of you for physical damage and reduce their protections for a duration."
                    }
                  ]
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Ability 3: Protector’s Surge",
                  "bold": true,
                  "items": [
                    {
                      "text": "Fly to a target ally and descend on their location. When you land, heal the target ally and nearby allies and grant them protections for a duration."
                    }
                  ]
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Ultimate Ability: To the Skies!",
                  "bold": true,
                  "items": [
                    {
                      "text": "Send a mirror image into the sky to choose a landing location. After selecting a location, channel briefly, then teleport to that location. On landing, deal physical damage, knock back enemies, and grant yourself a shield for a duration."
                    },
                    {
                      "text": "You  are immobile and CC immune while channeling."
                    },
                    {
                      "text": "After landing all allies near your start location are also teleported and receive a shield."
                    }
                  ]
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Aspect of the Falcon releasing June 5th.",
                  "bold": true,
                  "items": [
                    {
                      "text": "Fracture no longer stuns but deals increased damage on the cleave. Protector’s Suge has reduced range but now can target a location spawning a wind sprite or targeting an enemy dealing damage and granting a gust attack. To the Skies! No longer teleports allies but deals bonus damage in the center."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
