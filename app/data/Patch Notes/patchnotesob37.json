    {
      "title": "New Classic God",
      "anchor": "New_Classic_God",
      "level": 2,
      "subsections": [
        {
          "title": "Bastet",
          "anchor": "Bastet",
          "level": 3,
          "content": [
            {
              "type": "list",
              "items": [
                {
                  "text": "Passive Nightstalker",
                  "bold": true,
                  "items": [
                    {
                      "text": "Hitting enemies grants lifesteal. Enemy gods hit grant strength and are revealed to you for a duration."
                    }
                  ]
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Ability 1: Pounce",
                  "bold": true,
                  "items": [
                    {
                      "text": "Leap to a target location dealing physical damage to enemies in the area. For a short duration, reactivate to leap back to your initial location. You gain increased movement speed while you can return."
                    }
                  ]
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Ability 2: Razor Whip",
                  "bold": true,
                  "items": [
                    {
                      "text": "Swipe at enemies in a cone, causing them to bleed for physical damage over time."
                    }
                  ]
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Ability 3: Ensnaring Claw",
                  "bold": true,
                  "items": [
                    {
                      "text": "Send a cat forward. If it hits an enemy, it roots them and nearby enemies briefly and deals physical damage. The cat persists for a duration or until defeated, attacking nearby enemies for physical damage and applying a slow."
                    }
                  ]
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Ultimate Ability: Cat Call",
                  "bold": true,
                  "items": [
                    {
                      "text": "Summon 3 spirit cats that follow you and attack nearby enemies for a duration. While they are active, you gain strength."
                    },
                    {
                      "text": "Cats cannot block movement and cannot attack structures."
                    },
                    {
                      "text": "Cats dash attack enemies, dealing physical damage and slowing them."
                    },
                    {
                      "text": "When you cast Razor Whip, each cat resets its dash cooldown and dashes to the first enemy hit."
                    },
                    {
                      "text": "When you cast Pounce, cats follow you through the leap."
                    }
                  ]
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Aspect of the Watchful Pride Releasing 19th June",
                  "bold": true,
                  "items": [
                    {
                      "text": "Pounce can no longer be activated again to return you to your starting location.  Hitting an enemy god with it grants Protections to nearby allies. Razor Whip deals less damage but Disarms bleeding enemies. Ensnaring Claw Stuns instead of Rooting.  Cat Call becomes Huntress of Bast."
                    },
                    {
                      "text": "Ultimate Ability (Aspect): Huntress of Bast",
                      "bold": true,
                      "items": [
                        {
                          "text": "Become CC immune and fire a spirit cat projectile forward, dealing physical damage, stunning the first enemy god hit and summoning a Huntress of Bast behind them, which carries them to the location you were standing when it was summoned."
                        },
                        {
                          "text": "Once it reaches that location, quicksand forms underneath them creating a vortex effect and dealing damage over time."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
