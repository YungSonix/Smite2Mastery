              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Ancient Fury Debuff",
                  "items": [
                    {
                      "text": "Increased %HP damage dealt to Towers & Phoenixes 33% -> 50%"
                    }
                  ]
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "text": "Phoenixes",
                  "items": [
                    {
                      "text": "Increased Health Regen 4 -> 8"
                    },
                    {
                      "text": "Fixed an issue where Phoenixes lost 10 Protections while below 50% HP"
                    }
                  ]
                },
                {
                  "text": "Totem",
                  "items": [
                    {
                      "text": "Now awards up to 100 XP per team, proportional to how much damage each contributed",
                      "items": [
                        {
                          "text": "Awarded to all contributors, regardless of which team scored the last hit or reached the total damage goal first"
                        },
                        {
                          "text": "Multiple damage contributors on the same team receive split XP"
                        }
                      ]
                    },
                    {
                      "text": "Increased Damage Mitigation vs damage sources outside of The Pit +50% -> +66%"
                    },
                    {
                      "text": "Fixed an issue where overkill damage was being factored in to Totem kill credit"
                    }
                  ]
                },
                {
                  "text": "Lane Minions",
                  "items": [
                    {
                      "text": "Pushed up the start time when Lane Minion strength vs Towers begins increasing from 25min to 20min"
                    },
                    {
                      "text": "Brute Minions (stronger Melees that begin spawning later in the game) now use a different character model than normal Melee Minions"
                    }
                  ]
                },
                {
                  "text": "Lane Minion Damage Mitigation",
                  "items": [
                    {
                      "text": "Lane Minion Damage Mitigation now mitigates more ability damage than attack damage. Minions also no longer have this Damage Mitigation for the first 3min"
                    },
                    {
                      "text": "Previously:",
                      "items": [
                        {
                          "text": "Minions had 1.75% base Damage Mitigation that scaled by +1.75% every 3 minutes (max. 19.25%)"
                        },
                        {
                          "text": "Minotaurs gain an additional +3.25% Damage Mitigation per 3min from Magical Damage sources (max. 50%)"
                        }
                      ]
                    },
                    {
                      "text": "Now:",
                      "items": [
                        {
                          "text": "Minions no longer have base Damage Mitigation on wave 1, but still gain Damage Mitigation every 3 minutes"
                        },
                        {
                          "text": "Their Damage Mitigation is now split by damage source:",
                          "items": [
                            {
                              "text": "Vs Attack Damage",
                              "items": [
                                {
                                  "text": "+1.4% Damage Mitigation (max. 14%)"
                                }
                              ]
                            },
                            {
                              "text": "Vs Ability/Item Damage",
                              "items": [
                                {
                                  "text": "+2.5% Damage Mitigation (max. 25%)"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "text": "Minotaurs gain an additional +2.5% Ability/Item Damage Mitigation per 3min (max. 50%)"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
