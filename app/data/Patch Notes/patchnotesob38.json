  "sections": [
    {
      "title": "New Classic God",
      "anchor": "New_Classic_God",
      "level": 2,
      "subsections": [
        {
          "title": "Chronos",
          "anchor": "Chronos",
          "level": 3,
          "content": [
            {
              "type": "list",
              "items": [
                {
                  "text": "Passive: Time Lord",
                  "bold": true,
                  "items": [
                    {
                      "text": "You become empowered as time flows around you. Over time you gain Intelligence. Stacks have a maximum and are permanent."
                    }
                  ]
                },
                {
                  "text": "Ability 1: Time Rift",
                  "bold": true,
                  "items": [
                    {
                      "text": "Create a rift in time that deals magical damage to all enemies in the area. Hitting a god permanently increases the Time Rift damage by 1."
                    }
                  ]
                },
                {
                  "text": "Ability 2: Accelerate",
                  "bold": true,
                  "items": [
                    {
                      "text": "Accelerate yourself for a duration. You gain Movement Speed (initial plus increasing over time) and increased Attack Speed. While Accelerate is active, the Wheel of Time stops; the quadrant it stopped on determines which bonus you receive:",
                      "items": [
                        {
                          "text": "Section 1: Heal based on your max health over time"
                        },
                        {
                          "text": "Section 2: Abilities cost no Mana"
                        },
                        {
                          "text": "Section 3: Increased Intelligence"
                        },
                        {
                          "text": "Section 4: Increased Intelligence contribution to your attacks."
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "Ability 3: Stop Time",
                  "bold": true,
                  "items": [
                    {
                      "text": "Fire spinning gears of time forward. Enemies hit have their Attack Speed reduced, ramping into a Stun. They Take Magical Damage on impact and Magical Damage when Stunned."
                    }
                  ]
                },
                {
                  "text": "Ultimate Ability: Rewind",
                  "bold": true,
                  "items": [
                    {
                      "text": "Teleport through time to a recent position, restoring your Health and mana to their earlier values. All your cooldowns reset instantly."
                    },
                    {
                      "text": "You become CC immune while Rewind prepares"
                    },
                    {
                      "text": "The Heal is not affected by Healing Reduction"
                    }
                  ]
                },
                {
                  "text": "Aspect of Relativity",
                  "bold": true,
                  "lead": "releasing July 2nd",
                  "items": [
                    {
                      "text": "Time Lord no longer grants Intelligence but instead creates a persistent Time Field around you. Allies in your Time Field gain bonuses when you use your other abilities."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
