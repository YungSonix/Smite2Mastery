    {
      "title": "Bug Fixes",
      "anchor": "Bug_Fixes",
      "level": 2,
      "content": [
        {
          "type": "list",
          "items": [
            {
              "text": "Osiris",
              "items": [
                {
                  "text": "Sickle Strike",
                  "items": [
                    {
                      "text": "Aspect of the Fragmented",
                      "items": [
                        {
                          "text": "Fixed an issue where Sickle Strike was not dealing correct damage to minions."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "Pharoah’s Curse",
              "items": [
                {
                  "text": "Item is now included in the store filter for Magical Protection"
                }
              ]
            },
            {
              "text": "War Banner",
              "items": [
                {
                  "text": "Fixed the description to not include Max Health"
                }
              ]
            },
            {
              "text": "Increased VO volume for Bastet, Ne Zha Fire Lord, and Tsukuyomi Silver Bullet"
            },
            {
              "text": "Fixed an issue with Sfx not playing for the Da Ji global emote"
            },
            {
              "text": "Fixed an issue where overkill damage on the Totem was being factored in to Totem kill credit"
            },
            {
              "text": "Fixed an issue with Chiron Aspect and the Fire Giant Dagger."
            },
            {
              "text": "Fixed issues around locking when Daily Rewards pop up."
            },
            {
              "text": "Fixed Player names sometimes being cut off on the T screen."
            },
            {
              "text": "Updated description on God Tokens on the Profile screen to make clear that they cannot be used on the most recently released God."
            },
            {
              "text": "Agreeing to the leaver penalty is no longer case sensitive."
            },
            {
              "text": "Fixed an issue where Gods without Aspects would have an uncolored damage type icon"
            },
            {
              "text": "Addressed issue with Horus Ult not Teleporting if it times out and targeter is invalid"
            },
            {
              "text": "Allow Bastet A01 to cancel after first leap for early cooldown start; and no return leap"
            },
            {
              "text": "Address interaction with Awilix A04 not properly stopping Bastet A01 refire window from opening"
            },
            {
              "text": "Fixed an issue where Xbalanque Ult could cause Towers to drop their targets"
            },
            {
              "text": "Fixed Nu Wa exploding her own Mike Typhon"
            }
          ]
        }
      ],
      "subsections": []
    }
  ]
