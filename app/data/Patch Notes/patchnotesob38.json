    {
      "title": "Events",
      "anchor": "Events",
      "level": 2,
      "subsections": [
        {
          "title": "Next Race to Radiant - Chronos",
          "anchor": "Next_Race_to_Radiant_-_Chronos",
          "level": 3,
          "content": [
            {
              "type": "list",
              "items": [
                {
                  "text": "Event runs June 30 - July 7"
                },
                {
                  "text": "Top 100 (up from 50) Get the Mastery Emblem"
                },
                {
                  "text": "Top 200 (up from 100)  Get the Radiant Badge"
                },
                {
                  "text": "Top 500 (up from 200) Get the Tracker with their number"
                },
                {
                  "text": "Everyone who hits Radiant within the event gets a badge"
                },
                {
                  "text": "New: Worshipper earn rate in Co-Op vs. AI will be reduced during the update where they are part of a race."
                }
              ]
            }
          ]
        },
        {
          "title": "New: Race to Exalted",
          "anchor": "New:_Race_to_Exalted",
          "level": 3,
          "content": [
            {
              "type": "list",
              "items": [
                {
                  "text": "Introducing an Exalted race for previously released Gods."
                },
                {
                  "text": "Scylla will be the first event which  will start on July 7 and run through July 14 with the same rules and rewards as the Race to Radiant!"
                },
                {
                  "text": "Each update we will announce a new Race to Exalted for previously released Gods."
                }
              ]
            }
          ]
        }
      ]
