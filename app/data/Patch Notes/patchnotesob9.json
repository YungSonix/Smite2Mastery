    {
      "title": "New Ported God",
      "anchor": "New_Ported_God",
      "level": 2,
      "content": [
        {
          "type": "list",
          "items": [
            {
              "text": "Guan Yu",
              "bold": true,
              "items": [
                {
                  "text": "General",
                  "items": [
                    {
                      "text": "Melee Basic Attacks"
                    },
                    {
                      "text": "Damage Type: Physical"
                    },
                    {
                      "text": "Scaling Type: Hybrid Scaling"
                    }
                  ]
                },
                {
                  "text": "Passive: Battle Fervor",
                  "items": [
                    {
                      "text": "Gain Stacks of Fervor when dealing or taking damage",
                      "items": [
                        {
                          "text": "Fervor provides Attack Speed per stack"
                        },
                        {
                          "text": "At Maximum Stacks it provides more Attack Speed"
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "Ability 1: Conviction",
                  "items": [
                    {
                      "text": "Heals nearby allies for Health",
                      "items": [
                        {
                          "text": "Healing allied gods reduces Guan Yu and his allies cooldowns"
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "Ability 2: Warrior’s Will",
                  "items": [
                    {
                      "text": "Dash forward, dealing Physical Damage to and Slowing enemies you pass through",
                      "items": [
                        {
                          "text": "Hitting enemy gods reduces your cooldowns"
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "Ability 3: Taolu Assault",
                  "items": [
                    {
                      "text": "Swing your blade in a flurry, dealing Physical Damage repeatedly and stealing their protections",
                      "items": [
                        {
                          "text": "Damages 10 times in 3s"
                        },
                        {
                          "text": "Every 25% Attack Speed causes it to damage 1 additional time"
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "Ultimate Ability: Cavalry Charge",
                  "items": [
                    {
                      "text": "Mount a warhorse gaining crowd control immunity. Strike enemies while riding dealing Physical Damage. Dismount with a final swing that also Stuns all enemies hit.",
                      "items": [
                        {
                          "text": "Enemies hit by previous strikes take increased damage from the strike. This stacks"
                        },
                        {
                          "text": "Swing faster as you gain Attack Speed"
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "Aspect releasing May 9: Aspect of the General",
                  "items": [
                    {
                      "text": "Battle Fervor now provides Intelligence instead of Attack Speed. Conviction now applies an additional Heal over Time and will share Protections from Taolu Assault. However, Guan Yu loses all Strength scaling"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "subsections": []
    },
